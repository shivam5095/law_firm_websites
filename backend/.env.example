PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
RESEND_API_KEY=<set-resend-api-key>
