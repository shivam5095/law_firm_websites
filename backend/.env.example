NOTIFY_EMAIL=contact@example.com
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<set-a-strong-password>
